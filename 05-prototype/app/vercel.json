{
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/static/index.html" },
    { "source": "/:file((?:index|chon-khoa)[^/]*\\.html|tour[^/]*\\.js)", "destination": "/static/:file" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
